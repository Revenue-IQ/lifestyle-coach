# Copy to .env and fill in.

# Postgres. Locally this can be the Mac's own Postgres; in Docker it is the db service.
DATABASE_URL=postgres://localhost:5432/wellbeing

# "dev" accepts an x-dev-user-id header instead of a Clerk session, for local work
# before Clerk keys exist. Any other value (or unset) requires a real Clerk token.
AUTH_MODE=dev

# Clerk, from the Clerk dashboard (API keys). Required unless AUTH_MODE=dev.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

PORT=8787

# Gemini, called only from the backend. Empty: the coach is switched off and retrieval uses tags.
GEMINI_API_KEY=
# Model names, overridable here and nowhere else.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000
