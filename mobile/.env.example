# Copy to .env. Expo exposes EXPO_PUBLIC_* variables to the app.

# Where the API runs.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Clerk publishable key from the Clerk dashboard. Leave empty to use the dev
# sign-in (any email works) against an API running with AUTH_MODE=dev.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
