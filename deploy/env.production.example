# The server's env file. Copy to /opt/wellbeing/.env on the Lightsail instance and fill in.
# Never commit the filled-in file; it never leaves the server.

# Letters and digits only (it is embedded in a connection URL).
POSTGRES_PASSWORD=

# Login. "clerk" verifies Clerk session tokens with the secret key below.
# "dev" accepts any email on a developer sign-in screen; the web build must then be made
# without EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (see .github/workflows/deploy.yml).
AUTH_MODE=clerk
CLERK_SECRET_KEY=

# Gemini, called only from the API. Empty: the coach says it is switched off.
GEMINI_API_KEY=
# Optional model overrides. Defaults live in api/src/config/env.ts.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_TEXT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
# GEMINI_TIMEOUT_MS=15000
